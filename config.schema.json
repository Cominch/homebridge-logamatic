{
  "pluginAlias": "Logamatic",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "required": true,
        "default": "Logamatic"
      },
      "url": {
        "title": "URL",
        "type": "string",
        "required": true,
        "default": "http://0.0.0.0:80"
      },
      "gatewayPassword": {
        "title": "Gateway Password",
        "type": "string",
        "required": true,
        "default": "abcd-abcd-abcd-abcd"
      },
      "privatePassword": {
        "title": "Private Password",
        "type": "string",
        "required": true,
        "default": "password"
      },
      "heaterCircuit": {
        "title": "Heater Circuit",
        "type": "string",
        "required": true,
        "default": "hc1"
      },
      "waterCircuit": {
        "title": "Water Circuit",
        "type": "string",
        "required": true,
        "default": "dhw1"
      },
      "solarCircuit": {
        "title": "Solar Circuit",
        "type": "string",
        "required": false,
        "description": "Optional, e.g. sc1. Adds temperature sensors for the solar collector and the solar tank. Leave empty if you have no solar system."
      },
      "systemPressure": {
        "title": "Show System Pressure",
        "type": "boolean",
        "required": false,
        "description": "Adds a sensor with the system pressure. HomeKit has no pressure sensor, so the value in bar is shown as a temperature."
      }
    }
  }
}